From: yplam <yplam@yplam.com>
Subject: [PATCH] clk: rk3399: generate the gmac clock internally

rk3399_gmac_set_clk() only accepts an external clock on clkin_gmac and
fails otherwise. A board whose PHY has no crystal (the MRK3399's RTL8201F
on RMII) needs the SoC to send the 50 MHz reference clock out on mac_clk
from clk_gmac, as Linux does: without it the PHY never answers on MDIO.

Run NPLL, unused elsewhere in U-Boot, at 1 GHz and divide clk_gmac from it
(CLKSEL_CON20: PLL select in bits 15:14, divider in bits 12:8, as in
Linux clk-rk3399.c). 1 GHz gives both 50 MHz and 125 MHz exactly; GPLL
and CPLL give neither.

Also fix the HCLK_HOST0/1(_ARB) gates, which wrote CLKSEL_CON20 instead of
CLKGATE_CON20. Bit 8 of CLKSEL_CON20 is in the clk_gmac divider, so
starting USB would have changed the Ethernet clock.

---
diff --git a/drivers/clk/rockchip/clk_rk3399.c b/drivers/clk/rockchip/clk_rk3399.c
--- a/drivers/clk/rockchip/clk_rk3399.c
+++ b/drivers/clk/rockchip/clk_rk3399.c
@@ -55,6 +55,9 @@
 
 static const struct pll_div gpll_init_cfg = PLL_DIVISORS(GPLL_HZ, 2, 2, 1);
 static const struct pll_div cpll_init_cfg = PLL_DIVISORS(CPLL_HZ, 1, 2, 2);
+/* NPLL feeds clk_gmac when the MAC clock is generated internally */
+#define NPLL_HZ		(1000 * MHz)
+static const struct pll_div npll_init_cfg = PLL_DIVISORS(NPLL_HZ, 3, 2, 1);
 #if !defined(CONFIG_XPL_BUILD)
 static const struct pll_div ppll_init_cfg = PLL_DIVISORS(PPLL_HZ, 2, 2, 1);
 #endif
@@ -169,6 +172,13 @@
 	ACLK_PERIHP_DIV_CON_SHIFT	= 0,
 	ACLK_PERIHP_DIV_CON_MASK	= 0x1f,
 
+	/* CLKSEL_CON20 */
+	CLK_GMAC_PLL_SEL_SHIFT		= 14,
+	CLK_GMAC_PLL_SEL_MASK		= 3 << CLK_GMAC_PLL_SEL_SHIFT,
+	CLK_GMAC_PLL_SEL_NPLL		= 2,
+	CLK_GMAC_DIV_CON_SHIFT		= 8,
+	CLK_GMAC_DIV_CON_MASK		= 0x1f << CLK_GMAC_DIV_CON_SHIFT,
+
 	/* CLKSEL_CON21 */
 	ACLK_EMMC_PLL_SEL_SHIFT         = 7,
 	ACLK_EMMC_PLL_SEL_MASK          = 0x1 << ACLK_EMMC_PLL_SEL_SHIFT,
@@ -820,7 +830,7 @@
 
 static ulong rk3399_gmac_set_clk(struct rockchip_cru *cru, ulong rate)
 {
-	ulong ret;
+	u32 div;
 
 	/*
 	 * The RGMII CLK can be derived either from an external "clkin"
@@ -828,18 +838,27 @@
 	 */
 	if (readl(&cru->clksel_con[19]) & BIT(4)) {
 		/* An external clock will always generate the right rate... */
-		ret = rate;
-	} else {
-		/*
-		 * No platform uses an internal clock to date.
-		 * Implement this once it becomes necessary and print an error
-		 * if someone tries to use it (while it remains unimplemented).
-		 */
-		pr_err("%s: internal clock is UNIMPLEMENTED\n", __func__);
-		ret = 0;
+		return rate;
 	}
 
-	return ret;
+	/*
+	 * Internal clock: clk_gmac from NPLL, which nothing else in U-Boot
+	 * uses. GPLL (594 MHz) and CPLL (384 MHz) divide to neither 50 MHz
+	 * (RMII) nor 125 MHz (RGMII); NPLL at 1 GHz gives both exactly.
+	 */
+	div = NPLL_HZ / rate;
+	if (!div || div > 32 || NPLL_HZ % rate) {
+		pr_err("%s: can't derive %lu Hz from NPLL\n", __func__, rate);
+		return 0;
+	}
+
+	rkclk_set_pll(&cru->npll_con[0], &npll_init_cfg);
+	rk_clrsetreg(&cru->clksel_con[20],
+		     CLK_GMAC_PLL_SEL_MASK | CLK_GMAC_DIV_CON_MASK,
+		     CLK_GMAC_PLL_SEL_NPLL << CLK_GMAC_PLL_SEL_SHIFT |
+		     (div - 1) << CLK_GMAC_DIV_CON_SHIFT);
+
+	return rate;
 }
 
 #define PMUSGRF_DDR_RGN_CON16 0xff330040
@@ -1234,16 +1253,16 @@
 		rk_clrreg(&priv->cru->clkgate_con[30], BIT(4));
 		break;
 	case HCLK_HOST0:
-		rk_clrreg(&priv->cru->clksel_con[20], BIT(5));
+		rk_clrreg(&priv->cru->clkgate_con[20], BIT(5));
 		break;
 	case HCLK_HOST0_ARB:
-		rk_clrreg(&priv->cru->clksel_con[20], BIT(6));
+		rk_clrreg(&priv->cru->clkgate_con[20], BIT(6));
 		break;
 	case HCLK_HOST1:
-		rk_clrreg(&priv->cru->clksel_con[20], BIT(7));
+		rk_clrreg(&priv->cru->clkgate_con[20], BIT(7));
 		break;
 	case HCLK_HOST1_ARB:
-		rk_clrreg(&priv->cru->clksel_con[20], BIT(8));
+		rk_clrreg(&priv->cru->clkgate_con[20], BIT(8));
 		break;
 	case SCLK_UPHY0_TCPDPHY_REF:
 		rk_clrreg(&priv->cru->clkgate_con[13], BIT(4));
@@ -1329,16 +1348,16 @@
 		rk_setreg(&priv->cru->clkgate_con[30], BIT(4));
 		break;
 	case HCLK_HOST0:
-		rk_setreg(&priv->cru->clksel_con[20], BIT(5));
+		rk_setreg(&priv->cru->clkgate_con[20], BIT(5));
 		break;
 	case HCLK_HOST0_ARB:
-		rk_setreg(&priv->cru->clksel_con[20], BIT(6));
+		rk_setreg(&priv->cru->clkgate_con[20], BIT(6));
 		break;
 	case HCLK_HOST1:
-		rk_setreg(&priv->cru->clksel_con[20], BIT(7));
+		rk_setreg(&priv->cru->clkgate_con[20], BIT(7));
 		break;
 	case HCLK_HOST1_ARB:
-		rk_setreg(&priv->cru->clksel_con[20], BIT(8));
+		rk_setreg(&priv->cru->clkgate_con[20], BIT(8));
 		break;
 	case SCLK_UPHY0_TCPDPHY_REF:
 		rk_setreg(&priv->cru->clkgate_con[13], BIT(4));
