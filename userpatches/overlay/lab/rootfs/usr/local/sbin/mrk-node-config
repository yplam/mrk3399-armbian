#!/bin/bash
#
# Applies the node's settings from the config partition at every boot, before
# networking and sshd start (mrk-node-config.service). See docs/k8s-lab.md.
#
#   node.conf        HOSTNAME, ADDRESS, GATEWAY, DNS, NTP
#   authorized_keys  installed for root and the default user
#   identity/ssh/    SSH host keys: restored, or generated and saved once
#
# Everything is (re)written from the config partition on each boot, so it is
# the single source of truth: edit node.conf and reboot. The machine-id is
# restored earlier, by the initramfs (scripts/local-bottom/mrk3399-lab).
#
# The resolved values go to /run/mrk/node.env for other tools.

set -euo pipefail

CONFIG=/run/mrk/config
NODE_CONF="${CONFIG}/node.conf"
LAB_CONF=/etc/mrk3399/lab.conf
# The on-board GMAC, by device path: its name (eth0, end0) depends on udev.
ETH_PATH=platform-fe300000.ethernet
ETH_SYSFS=/sys/bus/platform/devices/fe300000.ethernet/net

log() { echo "mrk-node-config: $*"; }
warn() { echo "mrk-node-config: $*" >&2; }

declare -A conf=()

# KEY=value lines; # comments, blank lines and Windows line endings are fine.
# Not sourced: a typo in the file must not be able to run anything.
read_node_conf() {
	local line n=0
	[ -r "${NODE_CONF}" ] || { warn "no ${NODE_CONF}, using defaults"; return 0; }
	while IFS= read -r line || [ -n "${line}" ]; do
		n=$((n + 1))
		line="${line%$'\r'}"
		[[ "${line}" =~ ^[[:space:]]*(#|$) ]] && continue
		if [[ "${line}" =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]]; then
			conf[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
		else
			warn "node.conf line ${n} ignored: ${line}"
		fi
	done < "${NODE_CONF}"
}

# $1 with commas turned into spaces, for systemd's space-separated lists.
list() { echo "${1//,/ }"; }

apply_hostname() {
	local name="${conf[HOSTNAME]:-}"
	if [ -z "${name}" ]; then
		name="mrk-$(tr -d ':' <<< "${MAC:-000000000000}" | tail -c 7)"
	fi
	if ! [[ "${name}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
		warn "HOSTNAME=${name} isn't a valid lowercase host name; using mrk-node"
		name=mrk-node
	fi
	echo "${name}" > /etc/hostname
	hostname "${name}"
	# Debian's convention for the host's own name without a DNS entry.
	# Rewritten in place rather than with sed -i, which renames over the
	# file and fails where /etc/hosts is a bind mount.
	local hosts
	hosts=$(grep -v '^127\.0\.1\.1[[:space:]]' /etc/hosts || true)
	printf '%s\n127.0.1.1\t%s\n' "${hosts}" "${name}" > /etc/hosts
	HOST="${name}"
}

# A runtime .network file that sorts before netplan's catch-all DHCP one
# (10-netplan-*.network), so it wins for the GMAC.
apply_network() {
	local address="${conf[ADDRESS]:-dhcp}" f=/run/systemd/network/06-mrk-node.network dns
	mkdir -p /run/systemd/network
	{
		echo "# Generated by mrk-node-config from ${NODE_CONF}"
		echo "[Match]"
		echo "Path=${ETH_PATH}"
		echo
		echo "[Network]"
		if [ "${address}" = dhcp ]; then
			echo "DHCP=ipv4"
		elif [[ "${address}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]]; then
			echo "Address=${address}"
			[ -n "${conf[GATEWAY]:-}" ] && echo "Gateway=${conf[GATEWAY]}"
			[ -n "${conf[DNS]:-}" ] || warn "static ADDRESS without DNS: name resolution won't work"
		else
			warn "ADDRESS=${address} is neither dhcp nor a.b.c.d/len; using DHCP"
			echo "DHCP=ipv4"
			address=dhcp
		fi
		for dns in $(list "${conf[DNS]:-}"); do echo "DNS=${dns}"; done
		echo
		echo "[DHCPv4]"
		# The host name comes from node.conf, not from the DHCP server.
		echo "UseHostname=no"
	} > "${f}"
	ADDRESS="${address}"
}

# Empty NTP: timesyncd's usual sources (DHCP, then Debian's pool).
apply_ntp() {
	local d=/run/systemd/timesyncd.conf.d
	rm -f "${d}/mrk-node.conf"
	[ -n "${conf[NTP]:-}" ] || return 0
	mkdir -p "${d}"
	printf '# Generated by mrk-node-config\n[Time]\nNTP=%s\n' "$(list "${conf[NTP]}")" > "${d}/mrk-node.conf"
}

apply_authorized_keys() {
	local src="${CONFIG}/authorized_keys" user home
	[ -r "${src}" ] || return 0
	for user in root "${DEFAULT_USER:-}"; do
		[ -n "${user}" ] || continue
		home=$(getent passwd "${user}" | cut -d: -f6) || continue
		install -d -m 0700 -o "${user}" -g "$(id -gn "${user}")" "${home}/.ssh"
		tr -d '\r' < "${src}" > "${home}/.ssh/authorized_keys"
		chown "${user}:$(id -gn "${user}")" "${home}/.ssh/authorized_keys"
		chmod 0600 "${home}/.ssh/authorized_keys"
	done
}

# The image ships without host keys (they'd be the same on every node).
# The first boot generates them and keeps them on the config partition, so
# the node keeps its SSH identity across resets and upgrades.
apply_ssh_host_keys() {
	local saved="${CONFIG}/identity/ssh" k
	if compgen -G "${saved}/ssh_host_*_key" > /dev/null; then
		for k in "${saved}"/ssh_host_*; do
			install -m "$([[ "${k}" == *.pub ]] && echo 0644 || echo 0600)" "${k}" /etc/ssh/
		done
	else
		log "generating SSH host keys"
		ssh-keygen -A
		if [ -d "${CONFIG}" ] && mountpoint -q "${CONFIG}"; then
			mkdir -p "${saved}"
			cp /etc/ssh/ssh_host_* "${saved}/"
		fi
	fi
}

main() {
	# DEFAULT_USER: the account the build created (MRK3399_USER).
	# shellcheck source=/dev/null
	[ -r "${LAB_CONF}" ] && . "${LAB_CONF}"

	IFACE=$(ls "${ETH_SYSFS}" 2> /dev/null | head -n1 || true)
	MAC=""
	[ -n "${IFACE}" ] && MAC=$(cat "/sys/class/net/${IFACE}/address")

	read_node_conf
	apply_hostname
	apply_network
	apply_ntp
	apply_authorized_keys
	apply_ssh_host_keys

	cat > /run/mrk/node.env <<- EOF
		HOSTNAME=${HOST}
		IFACE=${IFACE}
		MAC=${MAC}
		ADDRESS=${ADDRESS}
		LAB_SERVER=${conf[LAB_SERVER]:-}
	EOF
	log "${HOST}: ${IFACE:-no ethernet} ${MAC} ${ADDRESS}"
}

main "$@"
